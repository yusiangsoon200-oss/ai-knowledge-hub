{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-knowledge-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-knowledge-hub-cms"
    }
  ],
  "vars": {
    "CMS_BASE_URL": "https://ai-knowledge-hub.yusiangsoon200.workers.dev"
  }
}
