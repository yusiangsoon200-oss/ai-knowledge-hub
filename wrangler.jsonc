{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-knowledge-hub-cms-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-knowledge-hub-cms",
      "database_id": "1c3469dc-d404-45dc-81e0-55987b8c57f1"
    }
  ],
  "vars": {
    "CMS_BASE_URL": "http://localhost:8787"
  }
}
